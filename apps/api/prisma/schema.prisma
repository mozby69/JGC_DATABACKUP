// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id       Int     @id @default(autoincrement()) @map("user_id")
  name     String  @db.VarChar(150)
  username String  @unique @db.VarChar(100)
  email    String? @unique @db.VarChar(191)
  password String  @db.VarChar(255)

  isActive Boolean @default(true) @map("is_active")

  branchId Int?
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  backups Backup[]

  roles UserRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Role {
  id          Int     @id @default(autoincrement()) @map("role_id")
  name        String  @unique @map("role_name") @db.VarChar(100)
  description String? @db.Text

  users UserRole[]

  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Permission {
  id          Int              @id @default(autoincrement()) @map("permission_id")
  code        String           @unique
  name        String           @unique @db.VarChar(100)
  description String?          @db.Text
  roles       RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}



model Branch {
  users User[]
  backups Backup[]
  id Int @id @default(autoincrement())

  branchCode String @unique @db.VarChar(30)
  branchName String @db.VarChar(150)

  ipAddress String @db.VarChar(255)
  sshPort   Int    @default(22)
  sshUsername String @db.VarChar(100)

  backupFolder String @db.VarChar(500)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("branches")
}

enum BackupStatus {
  UPLOADING
  COMPLETE
  FAILED
}

model Backup {
  id String @id @default(uuid()) @db.VarChar(36)
  backupNo String @unique @db.VarChar(50)
  branchId Int
  uploadedById Int
  backupDate DateTime @db.Date
  subject String @db.VarChar(500)
  status BackupStatus @default(UPLOADING)
  // Connection snapshot keeps historical backups reachable after branch edits.
  storageHost String @db.VarChar(255)
  storagePort Int
  storageUsername String @db.VarChar(100)
  storageKeyName String @db.VarChar(100)
  remoteDirectory String @db.VarChar(1000)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  files BackupFile[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([branchId, backupDate])
  @@index([uploadedById, createdAt])
  @@map("backups")
}

model BackupFile {
  id String @id @default(uuid()) @db.VarChar(36)
  backupId String @db.VarChar(36)
  originalName String @db.VarChar(255)
  storedName String @db.VarChar(100)
  size BigInt
  backup Backup @relation(fields: [backupId], references: [id], onDelete: Cascade)
  @@index([backupId])
  @@map("backup_files")
}
